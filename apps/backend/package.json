{
  "name": "@idcp/backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --tsconfig=../../tsconfig.base.json --external:@fastify/cors --external:@fastify/multipart --external:@fastify/rate-limit --external:@node-rs/argon2 --external:exceljs --external:fastify --external:jsonwebtoken --external:nodemailer --external:mysql2 --external:pg --external:zod --outfile=dist/server.js && esbuild src/db/migrate-cli.ts --bundle --platform=node --format=cjs --target=node22 --tsconfig=../../tsconfig.base.json --external:@fastify/cors --external:@fastify/multipart --external:@fastify/rate-limit --external:@node-rs/argon2 --external:exceljs --external:fastify --external:jsonwebtoken --external:nodemailer --external:mysql2 --external:pg --external:zod --outfile=dist/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@idcp/connectors": "*",
    "@idcp/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.24.2",
    "smtp-server": "^3.21.6",
    "tsx": "^4.19.2"
  }
}
