# =============================================================================
# AI Universal Data Capture Platform — configuration example
# =============================================================================
# Copy this file to .env and fill in LOCAL values only:
#
#     cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# Values below are PLACEHOLDERS. No real credential belongs in this repository.
# When you add a new key, document it here in the same commit (see AI.md §7).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                  # development | test | production
PORT=4000                             # API listen port
API_BASE_URL=http://localhost:4000/api/v1
LOG_LEVEL=debug                       # error | warn | info | debug
APP_ORIGIN=http://localhost:5173      # allowed browser origin (dev)

# --- Database (PostgreSQL 16) ---------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://idcp:CHANGE_ME_LOCAL@localhost:5432/idcp_dev
DATABASE_POOL_SIZE=10

# --- Cache / queue (Redis 7) ----------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentication --------------------------------------------------------
# Generate locally, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-local-secret
ACCESS_TOKEN_TTL=900                  # seconds (15 minutes)
REFRESH_TOKEN_TTL=2592000             # seconds (30 days)
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
PAIRING_TOKEN_TTL=120                 # seconds (2 minutes)

# --- Object storage (document images) -------------------------------------
STORAGE_DRIVER=minio                  # minio (local) | s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=idcp-documents-dev
S3_ACCESS_KEY_ID=CHANGE_ME_LOCAL
S3_SECRET_ACCESS_KEY=CHANGE_ME_LOCAL
S3_FORCE_PATH_STYLE=true              # required for MinIO

# --- AI / OCR --------------------------------------------------------------
AI_PROVIDER=local                     # local | cloud provider name (requires approval, PRD.json Q-001)
AI_LOCAL_ENGINE=tesseract
AI_CLOUD_API_KEY=                     # leave empty when AI_PROVIDER=local
AI_CLOUD_ENDPOINT=
AI_MAX_COST_MICROS_PER_DOC=0          # 0 = no cloud spend allowed
AI_REVIEW_CONFIDENCE_THRESHOLD=0.85   # below this a field needs human review

# --- Google Sheets connector ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/connectors/google/callback

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_REQUEST_MB=50
RATE_LIMIT_AUTH_PER_15_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=60

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=false

# --- Mobile / desktop build-time values (never secrets) -------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
