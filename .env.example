# =============================================================================
# AI Universal Data Capture Platform — configuration example
# =============================================================================
# Copy this file to .env and fill in LOCAL values only:
#
#     cp .env.example .env
#
# Every key below is read by the code (see apps/backend/src/config.ts). A test keeps the two in
# step: `apps/backend/test/config.test.ts` fails if a key exists in one and not the other.
#
# .env is gitignored and must NEVER be committed. Values here are PLACEHOLDERS, and the defaults in
# parentheses are what the server uses when the key is absent — a working local setup needs no .env
# at all.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development                  # development | production | test  (development)
PORT=4000                             # API listen port                (4000)
API_BASE_URL=http://localhost:4000/api/v1   # public API base; also baked into desktop releases at build time
LOG_LEVEL=info                        # error | warn | info | debug    (info)
APP_ORIGIN=http://localhost:5173      # origin that opens invitation links (the desktop dev server)
LEGAL_DIR=./legal                     # privacy policy, terms, DPA served by /legal/:slug
# Comma-separated allowed browser origins; include app://idcp for packaged Electron clients in production.
CORS_ORIGINS=

# --- Database ----------------------------------------------------------------
# `sqlite` needs no server: it uses Node's built-in node:sqlite and is the local/test default.
# `postgres` needs DATABASE_URL and is the production path (DEC-013).
DB_DRIVER=sqlite                      # sqlite | postgres             (sqlite)
SQLITE_PATH=./local-storage/idcp.db   # file used when DB_DRIVER=sqlite
DATABASE_URL=                         # required only when DB_DRIVER=postgres
                                      # e.g. postgresql://idcp:CHANGE_ME_LOCAL@localhost:5432/idcp
DATABASE_POOL_SIZE=10                 # postgres pool size             (10)

# --- Authentication ----------------------------------------------------------
# Development default is a well-known secret; production refuses to start without 32+ characters.
JWT_SECRET=local-development-secret-do-not-use-in-production
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes                     (900)
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days                        (2592000)
PAIRING_TOKEN_TTL_SECONDS=120         # QR pairing code life           (120)
INVITATION_TTL_SECONDS=604800         # invitation link life, 7 days   (604800)
PASSWORD_RESET_TTL_SECONDS=3600       # reset link life, 1 hour        (3600)

# --- Document storage --------------------------------------------------------
# The filesystem adapter is the shipped default. `s3` is reserved for the object-storage adapter,
# which is not implemented yet — asking for it fails fast rather than pretending to work (DEC-029).
STORAGE_DRIVER=filesystem             # filesystem | s3                (filesystem)
STORAGE_PATH=./local-storage/documents   # where original files are written

# --- AI / OCR ----------------------------------------------------------------
AI_PROVIDER=local                     # local | cloud                  (local)
AI_LOCAL_ENGINE=tesseract             # local engine                   (tesseract)
TESSERACT_BIN=tesseract               # binary name or absolute path   (tesseract)
AI_CLOUD_MODEL=gpt-4o-mini            # request model name             (gpt-4o-mini)
AI_CLOUD_ENDPOINT=                    # required when AI_PROVIDER=cloud; must be a full URL
AI_CLOUD_API_KEY=                     # required when AI_PROVIDER=cloud; never commit a real one
AI_MAX_COST_MICROS_PER_DOC=0          # spend cap per document; cloud refuses to start at 0 (Q-001)
AI_REVIEW_CONFIDENCE_THRESHOLD=0.85   # below this a field is queued for review   (0.85)

# --- Upload limits and rate limiting -----------------------------------------
MAX_UPLOAD_MB=20                      # per file                       (20)
MAX_REQUEST_MB=50                     # whole request (batch uploads)  (50)
RATE_LIMIT_ENABLED=true               #                              (true)
RATE_LIMIT_AUTH_PER_15_MIN=5          # sign-in attempts per IP        (5)
RATE_LIMIT_UPLOAD_PER_MIN=60          # uploads per organisation       (60)

# --- Exports and the background worker ---------------------------------------
EXPORTS_TTL_SECONDS=604800            # download link life, 7 days     (604800)
WORKER_ENABLED=true                   # run the in-process job worker  (true)
WORKER_POLL_INTERVAL_MS=500           # how often it looks for jobs    (500)
MAINTENANCE_ENABLED=true              # daily housekeeping tick        (true)
MAINTENANCE_INTERVAL_MS=86400000      # retention, exports, sessions   (86400000)

# Trust X-Forwarded-For for the client IP. Keep true behind the documented proxy; set false if
# the API is reachable directly, or a client can forge the header and dodge per-IP rate limits.
TRUST_PROXY=true                      # behind a reverse proxy           (true)

# --- Client build-time values (never secrets) --------------------------------
IDCP_API_URL=                         # mobile app: API base URL baked into the bundle
IDCP_API_PROXY=http://127.0.0.1:4000  # desktop dev server: where /api is proxied
IDCP_DEV_SERVER=                      # electron main: load the renderer from a dev server instead
IDCP_AUTO_UPDATE=on                   # electron main: `off` disables the updater
