# Copy to .env.compose, chmod 600, and replace all sample secrets/origins before use.
# Generate distinct random secrets, for example with: openssl rand -hex 32
# POSTGRES_PASSWORD is embedded in DATABASE_URL; use a URL-safe hex value (no @, :, /, or %).
POSTGRES_USER=idcp
POSTGRES_PASSWORD=replace-with-a-random-url-safe-database-secret
POSTGRES_DB=idcp
DATABASE_POOL_SIZE=10

# The known development defaults below are deliberately rejected by production config; replace them.
# Use distinct random values of at least 32 characters for JWT_SECRET and ENCRYPTION_KEY.
JWT_SECRET=local-development-secret-do-not-use-in-production
ENCRYPTION_KEY=local-encryption-secret-do-not-use-in-production
# Optional container paths: mount both a signed catalogue and its publisher public key read-only.
# With these unset, marketplace installs are disabled. Never mount the private signing key.
MARKETPLACE_CATALOGUE_PATH=
MARKETPLACE_PUBLIC_KEY_PATH=
API_BASE_URL=https://api.example.org/api/v1
APP_ORIGIN=https://app.example.org
# Add the web app origin and app://idcp for packaged Electron clients.
CORS_ORIGINS=https://app.example.org,app://idcp

# Configure a real sender and SMTP server to enable password-reset and invitation emails.
MAIL_TRANSPORT=disabled
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Keep the API bound to loopback behind a TLS-terminating reverse proxy by default.
API_HOST_BIND=127.0.0.1
API_PORT=4000
TRUST_PROXY=true
# Per-document current-version remote OCR invocation limit (0 disables remote OCR).
AI_MAX_REMOTE_CALLS_PER_DOC=5
# Lifetime per-organisation reservation limit since migration; no automatic reset. Zero disables calls.
AI_MAX_REMOTE_CALLS_PER_ORG=10000
WORKER_ENABLED=true
MAINTENANCE_ENABLED=true
