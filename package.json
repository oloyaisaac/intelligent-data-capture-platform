{
  "name": "idcp",
  "version": "0.1.0",
  "private": true,
  "description": "AI Universal Data Capture Platform \u2014 capture documents, extract structured data, review, and push to business systems.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --workspace @idcp/backend",
    "dev:mobile": "npm run start --workspace @idcp/mobile",
    "dev:desktop": "npm run dev --workspace @idcp/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.cjs",
    "test:unit": "jest --config jest.config.cjs --selectProjects shared connectors backend",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:prd": "node scripts/validate-prd.mjs",
    "db:migrate": "npm run db:migrate --workspace @idcp/backend",
    "db:seed": "npm run db:seed --workspace @idcp/backend",
    "verify": "npm run typecheck && npm run lint && npm run test:prd && npm run test:api && npm run test:packaging && npm run test:legal && npm test",
    "test:api": "node scripts/validate-openapi.mjs && node scripts/generate-udm-schema.mjs --check",
    "schema:udm": "node scripts/generate-udm-schema.mjs",
    "test:packaging": "node scripts/validate-packaging.mjs",
    "test:legal": "node scripts/validate-legal.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "yaml": "^2.9.1",
    "zod-to-json-schema": "^3.25.2"
  }
}
